# Server-only future SMTP settings. No provider selected, no real credentials.
SLM_ACCOUNT_EMAIL_ENABLED=false
SMTP_HOST=smtp.example.invalid
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.invalid
# Exact HTTPS callback, no wildcard, credentials, query string, or fragment.
SLM_EMAIL_CALLBACK_URL=https://app.example.invalid/email-callback.html
# Never enable for Cloud. Local test permits ONLY the isolated Mailpit host/recipients.
SLM_EMAIL_LOCAL_TEST=false
